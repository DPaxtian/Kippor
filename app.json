{
  "expo": {
    "name": "Kippor",
    "slug": "Kippor",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-light.png",
    "scheme": "kippor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "ipadOrientations": ["UIInterfaceOrientationLandscapeLeft", "UIInterfaceOrientationLandscapeRight"],
      "bundleIdentifier": "com.dpaxtian.Kippor",
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png",
        "light": "./assets/images/ios-light.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allows access to your photo library to add images to your product catalog.",
        "NSCameraUsageDescription": "Allows using the camera to take photos of your catalog products.",
        "NSUserNotificationsUsageDescription": "Allows receiving daily reminders about pending orders and sales summaries to help manage your business."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dpaxtian.Kippor",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F4",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#171311"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allows access to your photo library to add images to your product catalog.",
          "cameraPermission": "Allows using the camera to take photos of your catalog products."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Kippor_logo.png",
          "color": "#C45A3F",
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "./plugins/withPermissionStrings"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cc3d9a0-2f2d-430b-a2db-26c4685a4ee8"
      }
    }
  }
}